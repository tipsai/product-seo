# Copy to .env in your project root (not into the skill folder) and fill in.
# .env must be in .gitignore. The scripts read it; they never print the values.

# Search Console property: sc-domain:example.com or https://example.com/
GSC_SITE=

# Path to a service-account JSON key that is added as a user of the property.
# Keep the key outside the repository.
GSC_SERVICE_ACCOUNT_FILE=

# IndexNow key (8-128 letters, digits, dashes), hosted at https://<your-site>/<key>.txt
INDEXNOW_KEY=
